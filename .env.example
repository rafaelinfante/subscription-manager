# Copy to .env and fill in as needed. Nothing here is required to run locally with
# `docker compose up` — the defaults work and social login stays disabled until you
# add provider credentials.

# --- Database (already wired in docker-compose) ---
SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/subscription_manager?serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=subuser
SPRING_DATASOURCE_PASSWORD=subpass

# --- JWT signing key (optional) ---
# When unset, the backend generates an ephemeral RSA keypair at startup, which is fine
# for local use. Set a stable PEM keypair in any real deployment so tokens survive restarts.
# APP_JWT_RSA_PRIVATE_KEY=
# APP_JWT_RSA_PUBLIC_KEY=

# --- Social login (optional) ---
# Each provider activates only when both id and secret are present. Redirect URI to
# register with the provider: http://localhost:8080/login/oauth2/code/<provider>
OAUTH2_GOOGLE_CLIENT_ID=
OAUTH2_GOOGLE_CLIENT_SECRET=
OAUTH2_GITHUB_CLIENT_ID=
OAUTH2_GITHUB_CLIENT_SECRET=
OAUTH2_FACEBOOK_CLIENT_ID=
OAUTH2_FACEBOOK_CLIENT_SECRET=

# Where the backend sends the browser after a successful social login.
APP_FRONTEND_BASE_URL=http://localhost:4200
